{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.js": { "includeFiles": "public/**", "maxDuration": 30 },
    "api/[path].js": { "includeFiles": "public/**", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/auth/callback.html", "destination": "/auth-callback.html" }
  ]
}
